{
  "manifestVersion": 2,
  "id": "git-save-load",
  "name": "Git Save/Load",
  "version": "3.1.0",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "description": "Git 存档与读档。一键存档、版本历史浏览、分支管理、GitHub 仓库与 PR 管理、带二次确认的远程覆盖推送；为模型提供 git / gh 工具（含子命令透传与 PR 生命周期），并支持隔离 GPG 签名提交与加密存放的 GitHub 令牌。",
  "minAppVersion": "0.978.0",
  "capabilities": [
    "app/process.spawn",
    "app/tools.expose-to-model",
    "app/ui.open-external",
    "app/ui.clipboard-write",
    "app/resources.read",
    "app/resources.write"
  ],
  "contributes": {
    "settings": {
      "title": "Git Save/Load 设置",
      "ui": { "route": "/settings.html" },
      "schema": {
        "properties": {
          "repoPath": {
            "type": "string",
            "title": "仓库路径",
            "default": "",
            "description": "管理的 Git 仓库路径"
          },
          "stashMode": {
            "type": "string",
            "title": "暂存模式",
            "default": "untracked",
            "enum": ["normal", "untracked", "all"],
            "description": "暂存模式"
          },
          "pushMode": {
            "type": "string",
            "title": "推送模式",
            "default": "normal",
            "enum": ["normal", "force-with-lease", "force"],
            "description": "推送模式"
          },
          "pullMode": {
            "type": "string",
            "title": "拉取模式",
            "default": "merge",
            "enum": ["merge", "rebase", "ff-only"],
            "description": "拉取模式"
          },
          "defaultDiffMode": {
            "type": "string",
            "title": "Diff 显示模式",
            "default": "detail",
            "enum": ["detail", "simple"],
            "description": "默认 diff 显示模式"
          },
          "theme": {
            "type": "string",
            "title": "主题",
            "default": "auto",
            "enum": [
              "auto",
              "light",
              "dark",
              "warm-paper",
              "new-warm-paper",
              "midnight",
              "midnight-contrast",
              "high-contrast",
              "grass-aroma",
              "contemplation",
              "absolutely",
              "delve",
              "deep-think",
              "coral"
            ],
            "description": "主题"
          },
          "paperTexture": {
            "type": "string",
            "title": "纸质纹理",
            "default": "off",
            "enum": ["on", "off"],
            "description": "纸质纹理"
          },
          "ghOpenMode": {
            "type": "string",
            "title": "GitHub 链接打开方式",
            "default": "internal",
            "enum": ["internal", "external"],
            "description": "点击 GitHub 链接时在面板内打开还是系统浏览器打开"
          },
          "remoteSettings": {
            "type": "object",
            "title": "远程仓库设置",
            "default": {},
            "description": "按仓库保存的远程仓库角色和同步设置"
          }
        }
      }
    },
    "cards": [
      {
        "id": "git-save-load",
        "title": "Git Save/Load",
        "description": "Git 存档、读档、分支与远程仓库管理面板",
        "route": "/git.html",
        "realization": "page",
        "cardForm": "flush",
        "titlebar": "solid",
        "closable": false,
        "siteNavEntry": false,
        "fpFullPanel": true,
        "functionPanel": {
          "id": "git-save-load-panel",
          "label": "Git",
          "route": "/git.html"
        },
        "face": {
          "image": "assets/icon.png"
        }
      }
    ]
  }
}
