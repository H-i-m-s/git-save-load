{
  "manifestVersion": 1,
  "id": "git-save-load",
  "name": "Git Save/Load",
  "version": "2.2.0",
  "description": "Git 存档与读档。支持一键存档、版本历史浏览、分支管理、已有 GitHub 仓库关联，以及带二次确认的远程覆盖推送。",
  "trust": "full-access",
  "minAppVersion": "0.159.0",
  "ui": {
    "hostCapabilities": [
      "external.open",
      "clipboard.writeText"
    ]
  },
  "contributes": {
    "cards": [
      {
        "id": "git-save-load",
        "title": "Git Save/Load",
        "route": "/git",
        "realization": "page",
        "cardForm": "flush",
        "titlebar": "solid"
      }
    ],
    "configuration": {
      "type": "object",
      "properties": {
        "repoPath": {
          "type": "string",
          "default": "",
          "description": "管理的 Git 仓库路径"
        },
        "stashMode": {
          "type": "string",
          "default": "untracked",
          "enum": [
            "normal",
            "untracked",
            "all"
          ],
          "description": "暂存模式"
        },
        "pushMode": {
          "type": "string",
          "default": "normal",
          "enum": [
            "normal",
            "force-with-lease",
            "force"
          ],
          "description": "推送模式"
        },
        "pullMode": {
          "type": "string",
          "default": "merge",
          "enum": [
            "merge",
            "rebase",
            "ff-only"
          ],
          "description": "拉取模式"
        },
        "defaultDiffMode": {
          "type": "string",
          "default": "detail",
          "enum": [
            "detail",
            "simple"
          ],
          "description": "默认 diff 显示模式"
        },
        "theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark",
            "warm-paper",
            "new-warm-paper",
            "midnight",
            "midnight-contrast",
            "high-contrast",
            "grass-aroma",
            "contemplation",
            "absolutely",
            "delve",
            "deep-think",
            "coral"
          ],
          "description": "主题"
        },
        "paperTexture": {
          "type": "string",
          "default": "off",
          "enum": [
            "on",
            "off"
          ],
          "description": "纸质纹理"
        },
        "remoteSettings": {
          "type": "object",
          "default": {},
          "description": "按仓库保存的远程仓库角色和同步设置"
        }
      }
    }
  }
}
